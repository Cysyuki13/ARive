@echo off
REM =========================================================================
REM  ARive - auto-update WEAPON model folder index.js
REM  -------------------------------------------------------------------------
REM  Drop this file into assets/model/weaponModel/ and double-click to
REM  regenerate that folder's index.js  (window.ARIVE_WEAPON_FILES).
REM
REM  Same script as the generic update-index.bat, pre-set for the weapon
REM  folder.  For other folders change VARNAME below:
REM      furnitureModel  ->  ARIVE_FURNITURE_FILES
REM      structureModel  ->  ARIVE_STRUCTURE_FILES
REM      weaponModel     ->  ARIVE_WEAPON_FILES
REM =========================================================================

setlocal enabledelayedexpansion
pushd "%~dp0"

REM ---- CONFIG -------------------------------------------------------------
set "VARNAME=ARIVE_WEAPON_FILES"
set "OUT=index.js"
set "SKIP_PREFIX=_"
REM -------------------------------------------------------------------------

set "TMP=%TEMP%\arive_wpn_idx_%RANDOM%%RANDOM%.txt"
type nul > "%TMP%"

echo.
echo  Scanning:  %CD%
echo.

REM ---- 1. Collect every *.json (skip index/manifest + _templates) ---------
for /f "delims=" %%F in ('dir /b /on *.json 2^>nul') do (
    set "NAME=%%F"
    if /I not "!NAME!"=="index.json" if /I not "!NAME!"=="manifest.json" (
        if not "!NAME:~0,1!"=="%SKIP_PREFIX%" (
            >> "%TMP%" echo %%F
        )
    )
)

REM ---- 2. Count -----------------------------------------------------------
set /A COUNT=0
for /f "usebackq delims=" %%L in ("%TMP%") do set /A COUNT+=1

if !COUNT! EQU 0 (
    echo  [WARN] No .json files found - leaving %OUT% untouched.
    del "%TMP%" >nul 2>&1
    popd
    echo.
    pause
    exit /b 0
)

REM ---- 3. Header ----------------------------------------------------------
(
    echo /* =========================================================================
    echo    ARive -- weapon model file index
    echo    -------------------------------------------------------------------------
    echo    AUTO-GENERATED by update-weapon-index.bat - do not edit by hand.
    echo    Re-run the bat file after adding or removing .json files.
    echo    ========================================================================= */
    echo window.%VARNAME% = [
) > "%OUT%"

REM ---- 4. Entries ---------------------------------------------------------
set /A IDX=0
for /f "usebackq delims=" %%L in ("%TMP%") do (
    set /A IDX+=1
    set "COMMA=,"
    if !IDX! EQU !COUNT! set "COMMA="
    >> "%OUT%" echo     '%%L'!COMMA!
)

REM ---- 5. Footer ----------------------------------------------------------
(
    echo ];
    echo.
) >> "%OUT%"

REM ---- 6. Cleanup ---------------------------------------------------------
del "%TMP%" >nul 2>&1
popd

set "PLURAL=ies"
if !COUNT! EQU 1 set "PLURAL=y"

echo.
echo  Done -- wrote !COUNT! entr!PLURAL! to index.js
echo.
pause