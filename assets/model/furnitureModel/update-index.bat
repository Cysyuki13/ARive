@echo off
REM =========================================================================
REM  ARive - auto-update model folder index.js
REM  -------------------------------------------------------------------------
REM  Drop this file into any model folder (furnitureModel, structureModel, ...)
REM  and double-click to regenerate that folder's index.js.
REM
REM  For non-furniture folders, edit VARNAME below:
REM      furnitureModel  ->  ARIVE_FURNITURE_FILES
REM      structureModel  ->  ARIVE_STRUCTURE_FILES
REM =========================================================================

setlocal enabledelayedexpansion
pushd "%~dp0"

REM ---- CONFIG -------------------------------------------------------------
set "VARNAME=ARIVE_FURNITURE_FILES"
set "OUT=index.js"
REM -------------------------------------------------------------------------

set "TMP=%TEMP%\arive_idx_%RANDOM%%RANDOM%.txt"
if exist "%TMP%" del "%TMP%" >nul 2>&1

echo.
echo  Scanning:  %CD%
echo.

REM ---- 1. Collect every *.json (skip our own config files) ----------------
for /f "delims=" %%F in ('dir /b /on *.json 2^>nul') do (
    if /I not "%%F"=="index.json" if /I not "%%F"=="manifest.json" (
        >> "%TMP%" echo %%F
    )
)

REM ---- 2. Count -----------------------------------------------------------
set /A COUNT=0
for /f "usebackq delims=" %%L in ("%TMP%") do set /A COUNT+=1

REM ---- 3. Header ----------------------------------------------------------
(
    echo /* =========================================================================
    echo    ARive -- model file index
    echo    -------------------------------------------------------------------------
    echo    AUTO-GENERATED by update-index.bat -- do not edit by hand.
    echo    Re-run the bat file after adding or removing .json files.
    echo    ========================================================================= */
    echo window.%VARNAME% = [
) > "%OUT%"

REM ---- 4. Entries ---------------------------------------------------------
set /A IDX=0
for /f "usebackq delims=" %%L in ("%TMP%") do (
    set /A IDX+=1
    set "COMMA=,"
    if !IDX! EQU !COUNT! set "COMMA="
    >> "%OUT%" echo     '%%L'!COMMA!
)

REM ---- 5. Footer ----------------------------------------------------------
(
    echo ];
    echo.
) >> "%OUT%"

REM ---- 6. Cleanup ---------------------------------------------------------
del "%TMP%" >nul 2>&1
popd

set "PLURAL=ies"
if !COUNT! EQU 1 set "PLURAL=y"

echo.
echo  Done -- wrote !COUNT! entr!PLURAL! to index.js
echo.
pause